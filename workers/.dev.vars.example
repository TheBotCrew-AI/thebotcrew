# Local Worker secrets for `mastra dev` / `wrangler dev`.
# Copy to `workers/.dev.vars` (gitignored) and fill in. NEVER commit real values.

# Supabase — the Worker uses the service-role key (bypasses RLS). Server-side only.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="<local-service-role-key-from-`supabase start`>"

# AI providers — set whichever you have. Default provider is OpenAI (gpt-5-mini).
# Per-tenant overrides are stored in tenant_config.ai_provider / ai_model.
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional per-tenant keys, so a client's spend lands on its own key/project.
# Name: <PROVIDER>_API_KEY__<SLUG>, where <SLUG> matches tenant_config.ai_key_ref
# (uppercased, non-alphanumerics → `_`). The DB stores only the slug, never the key.
# A ref with no matching secret does NOT silence the tenant: it falls back to the
# platform key above and logs a `ai_key_fallback` bot_event. See docs/onboarding.md §6.
# OPENAI_API_KEY__MADI="sk-..."

# Meta Conversions API — per-tenant access token (Events Manager → Settings →
# Conversions API → Generate access token). Name: META_CAPI_TOKEN__<SLUG>, where
# <SLUG> matches tenant_config.meta_capi.token_ref (uppercased, non-alphanumerics
# → `_`). NO platform fallback on purpose: a Meta token belongs to one advertiser,
# so a missing secret parks the tenant's queue rows (capi_error) instead of
# sending its conversions to someone else's dataset. See docs/onboarding.md.
# META_CAPI_TOKEN__MADI="EAAG..."

# GoHighLevel — outbound transport + calendar (live, per-location OAuth).
GHL_API_BASE="https://services.leadconnectorhq.com"
# Inbound webhooks are verified by GHL's public keys (Ed25519 `x-ghl-signature` /
# RSA `x-wh-signature`), embedded in code — no secret needed. For LOCAL DEV only,
# set this to bypass verification so `webhook:simulate` works (NEVER in prod):
ALLOW_UNVERIFIED_WEBHOOKS="true"
# TODO(GHL auth): single agency token vs per-location OAuth. If per-tenant, this is the
# fallback/agency token and per-tenant tokens are resolved via tenants.ghl_token_ref.
GHL_API_TOKEN="<ghl-api-token>"

# Delivery retry cron — the scheduled event self-calls this endpoint.
# WORKER_URL is the deployed Worker URL (e.g. https://thebotcrew-agents.workers.dev).
# INTERNAL_CRON_SECRET is any strong random secret; generate with: openssl rand -hex 32
WORKER_URL="http://localhost:4111"
INTERNAL_CRON_SECRET="<random-secret>"

# Auth for /webhooks/ghl/appointments — the tenant-configured GHL WORKFLOW webhook
# (staff bookings → stats). Workflow Custom Webhooks are unsigned, so this shared
# bearer secret is the gate; the endpoint 401s (fails closed) while it is unset.
# Generate with: openssl rand -hex 32. The same value goes in each GHL workflow's
# Custom Webhook "Authorization: Bearer <value>" header.
GHL_WORKFLOW_SECRET="<random-secret>"

# Optional, local only (never a Worker secret): read Workers Logs with scripts/cf-logs.mjs.
# Cloudflare API token with the "Workers Observability: Read" permission.
CF_OBSERVABILITY_TOKEN=
