# The Bot Crew — environment reference. NEVER commit real values.
#
# Where these live:
#   • Local dev (`mastra dev`): copy this into `workers/.env` and fill in.
#   • Local Worker (`wrangler dev`): use `workers/.dev.vars` (see workers/.dev.vars.example).
#   • Production (Cloudflare): set each as a Worker secret —
#       wrangler secret put SUPABASE_SERVICE_ROLE_KEY   (etc.)
#   • Supabase local keys come from the output of `supabase start`.

# --- Supabase (server-side only; service-role BYPASSES RLS) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (agent model provider) ---
ANTHROPIC_API_KEY=

# --- GoHighLevel (transport: outbound send + calendar) ---
# Endpoints/auth still TBD; calls are stubbed until confirmed.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_WEBHOOK_SECRET=
# Agency/fallback token. Per-tenant tokens (TBD) resolve via tenants.ghl_token_ref.
GHL_API_TOKEN=
